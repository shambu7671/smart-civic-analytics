# ─────────────────────────────────────────────────────────────────────────────
# Smart Civic System — Production Environment Template
# Copy to .env.production and fill in real values before deploying.
# NEVER commit .env.production to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_SECRET

FLASK_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# Use Supabase Dashboard > Connect > Session pooler, with sslmode=require.
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=8

# ── AI / YOLO ─────────────────────────────────────────────────────────────────
# Set to "real" only when you have a trained checkpoint at AI_MODEL_PATH
AI_MODE=demo
AI_MODEL_PATH=ai/models/best.pt
AI_CONFIDENCE_THRESHOLD=0.55

# ── Duplicate Detection ───────────────────────────────────────────────────────
DUPLICATE_RADIUS_METERS=100
DUPLICATE_AUTO_LINK_THRESHOLD=0.82
DUPLICATE_CANDIDATE_THRESHOLD=0.45
DUPLICATE_LOCATION_WEIGHT=0.30
DUPLICATE_CATEGORY_WEIGHT=0.20
DUPLICATE_IMAGE_WEIGHT=0.30
DUPLICATE_TEXT_WEIGHT=0.20
IMAGE_SIMILARITY_THRESHOLD=0.65
TEXT_SIMILARITY_THRESHOLD=0.35

# ── DBSCAN Clustering ─────────────────────────────────────────────────────────
DBSCAN_EPS_METERS=80
DBSCAN_MIN_SAMPLES=2

# ── Priority Scoring ──────────────────────────────────────────────────────────
SEVERITY_WEIGHT=0.35
REPORT_WEIGHT=0.25
AGE_WEIGHT=0.20
LOCATION_WEIGHT=0.20
HIGH_PRIORITY_THRESHOLD=70
MEDIUM_PRIORITY_THRESHOLD=45

# ── Security ──────────────────────────────────────────────────────────────────
# Must be true in production (requires HTTPS)
SESSION_COOKIE_SECURE=true
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
# Store the complete service-account JSON as one Vercel environment variable.
FIREBASE_CREDENTIALS_JSON=SET_IN_VERCEL_ENVIRONMENT_VARIABLES
GEOTAG_MAX_DISTANCE_METERS=200
GEOTAG_ENFORCEMENT_MODE=warn

# ── Gunicorn ──────────────────────────────────────────────────────────────────
PORT=8000
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info
GUNICORN_ACCESS_LOG=logs/access.log
GUNICORN_ERROR_LOG=logs/error.log

# ── Proxy ─────────────────────────────────────────────────────────────────────
# Comma-separated list of trusted proxy IPs (nginx container IP)
FORWARDED_ALLOW_IPS=172.0.0.0/8
