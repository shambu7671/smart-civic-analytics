FLASK_ENV=development
SECRET_KEY=change-me-before-production
# For production, use the Supabase PostgreSQL session-pooler URI and sslmode=require.
DATABASE_URL=postgresql+psycopg2://smartcity:smartcity@localhost:5432/smart_civic
TEST_DATABASE_URL=postgresql+psycopg2://smartcity:smartcity@localhost:5432/smart_civic_test
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=8
AI_MODE=demo
AI_MODEL_PATH=ai/models/best.pt
AI_CONFIDENCE_THRESHOLD=0.55
DUPLICATE_RADIUS_METERS=100
DUPLICATE_AUTO_LINK_THRESHOLD=0.82
DUPLICATE_CANDIDATE_THRESHOLD=0.45
DUPLICATE_LOCATION_WEIGHT=0.30
DUPLICATE_CATEGORY_WEIGHT=0.20
DUPLICATE_IMAGE_WEIGHT=0.30
DUPLICATE_TEXT_WEIGHT=0.20
IMAGE_SIMILARITY_THRESHOLD=0.65
TEXT_SIMILARITY_THRESHOLD=0.35
DBSCAN_EPS_METERS=80
DBSCAN_MIN_SAMPLES=2
SEVERITY_WEIGHT=0.35
REPORT_WEIGHT=0.25
AGE_WEIGHT=0.20
LOCATION_WEIGHT=0.20
HIGH_PRIORITY_THRESHOLD=70
MEDIUM_PRIORITY_THRESHOLD=45
SESSION_COOKIE_SECURE=false

# Firebase Authentication (public web API key; safe to expose via /api/auth/config)
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
# Firebase Admin service-account JSON (server-side secret); never commit its value.
FIREBASE_CREDENTIALS_JSON=

# Private Supabase Storage. Keep the service-role key server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=report-images

# Public map exposes only verified/operational issue summaries, never citizen identity.

# ── Geotag / EXIF GPS verification ───────────────────────────────────────────
# Maximum allowed metres between photo EXIF GPS and submitted map pin.
GEOTAG_MAX_DISTANCE_METERS=200
# "warn" accepts MISMATCH with a warning flag; "strict" rejects the submission.
GEOTAG_ENFORCEMENT_MODE=warn

